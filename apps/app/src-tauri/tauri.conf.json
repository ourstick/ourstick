{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OurStick",
  "version": "0.1.1",
  "identifier": "com.ourstick.OurStick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OurStick",
        "width": 700,
        "height": 600,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../../../THIRD-PARTY-LICENSES.html": "THIRD-PARTY-LICENSES.html",
      "../../../LICENSE": "LICENSE.txt"
    },
    "category": "Utility",
    "shortDescription": "A USB stick in a link.",
    "longDescription": "Put folders on a stick in the OurStick app and send its link or QR code. The other person opens it in OurStick, picks what they want, and downloads it. Straight from your computer to theirs, encrypted on your device. No accounts, no size limits.",
    "homepage": "https://ourstick.com",
    "publisher": "Georgios Kakavelakis",
    "copyright": "© 2026 Georgios Kakavelakis. Apache-2.0.",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/com.ourstick.OurStick.metainfo.xml": "linux/com.ourstick.OurStick.metainfo.xml",
          "/usr/share/doc/ourstick/copyright": "linux/copyright"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
