# Nothing from other sites, ever: the link page holds a whole ticket, the
# stick's key included, in its address (after "#"), which any script it
# loaded could read. The one frame the link page makes opens the app with
# ourstick:receive, which carries nothing (ADR 0030).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; frame-src ourstick:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), clipboard-read=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
/THIRD-PARTY-LICENSES
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
# ADR 0027, decision 6: which app opens ourstick.com/s/ links on Android.
# The upload key's fingerprint; Play's app signing key joins it after the
# first upload to Play.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
# ADR 0033: the notice of a new version, read by the app once a day. A
# short cache, so that a security notice reaches every app within the day.
/version.json
  Content-Type: application/json
  Cache-Control: public, max-age=600
