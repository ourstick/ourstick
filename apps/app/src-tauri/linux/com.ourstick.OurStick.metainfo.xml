<component type="desktop-application">
  <id>com.ourstick.OurStick</id>
  <name>OurStick</name>
  <summary>A USB stick in a link</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <developer id="com.ourstick">
    <name>Giorgos</name>
  </developer>
  <description>
    <p>
      Put folders on a stick in the OurStick app and send its link or QR code.
      The other person opens it in OurStick, picks what they want, and
      downloads it, straight from your computer to theirs.
    </p>
    <p>
      Encrypted on your device. No accounts, no uploads to a cloud, no size
      limits. When you add files, the people who have your stick get them too.
    </p>
  </description>
