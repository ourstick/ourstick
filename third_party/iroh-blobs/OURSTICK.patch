--- a/src/store/fs.rs
+++ b/src/store/fs.rs
@@ -835,9 +835,12 @@
     fn drop(&mut self) {
         if let Some(rt) = self.0.take() {
             trace!("dropping tokio runtime");
-            tokio::task::block_in_place(|| {
-                drop(rt);
-            });
+            // OurStick patch: this runs on one of the runtime's own threads
+            // (the actor that owns it ends there), so a drop that waits for
+            // every thread of the runtime to end would wait for itself
+            // forever, and each store left its threads behind. Its threads
+            // end on their own instead.
+            rt.shutdown_background();
             trace!("dropped tokio runtime");
         }
     }
