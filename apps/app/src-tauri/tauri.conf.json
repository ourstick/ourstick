{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OurStick",
  "version": "0.1.0",
  "identifier": "com.ourstick.OurStick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OurStick",
        "width": 700,
        "height": 600,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "../../../THIRD-PARTY-LICENSES.html": "THIRD-PARTY-LICENSES.html"
    },
    "category": "Utility",
    "shortDescription": "A USB stick you can send.",
    "longDescription": "Put folders on a stick, send its link or QR code, and the other person sees and downloads the files on their computer. Peer to peer, encrypted on the device, no accounts, no size limits.",
    "homepage": "https://ourstick.com"
  }
}
